    "description": "Title of the switch, under the open player-count disclosure on the home screen, that turns the blocks rule on or off for the room being created."
  },
  "homeRuleBlocksHint": "Two of your tokens on one square cannot be passed",
  "@homeRuleBlocksHint": {
    "description": "Subtitle under the blocks switch on the home screen, explaining what the rule does."
  },
  "homeRuleCaptureBonus": "Capture bonus",
  "@homeRuleCaptureBonus": {
    "description": "Title of the switch, under the open player-count disclosure on the home screen, that turns the capture bonus rule on or off for the room being created."
  },
  "homeRuleCaptureBonusHint": "Sending a token home earns another roll",
  "@homeRuleCaptureBonusHint": {
    "description": "Subtitle under the capture bonus switch on the home screen, explaining what the rule does."
  },
  "homePlayersTwo": "2 players",
  "@homePlayersTwo": {
    "description": "Label of the segment that selects a two-seat room."
  },
  "homePlayersThree": "3 players",
  "@homePlayersThree": {
    "description": "Label of the segment that selects a three-seat room."
  },
  "homePlayersFour": "4 players",
  "@homePlayersFour": {
    "description": "Label of the segment that selects a four-seat room."
  },
  "lobbyConnecting": "Connecting to the room...",
  "@lobbyConnecting": {
    "description": "Shown on the lobby screen while the socket to the server is opening and the create or join request is in flight."
  },
  "lobbyConnectionLost": "Connection lost.",
  "@lobbyConnectionLost": {
    "description": "Shown on the lobby screen when the socket has closed and the player can choose to reconnect."
  },
  "lobbyReconnecting": "Reconnecting...",
  "@lobbyReconnecting": {
    "description": "Shown on the lobby screen and the game screen while an automatic reconnect attempt is scheduled or in flight."
  },
  "lobbyRoomCodeLabel": "Room code",
  "@lobbyRoomCodeLabel": {
    "description": "Caption shown above the room code on the lobby screen."
  },
  "lobbyCopyLinkButton": "Copy link",
  "@lobbyCopyLinkButton": {
    "description": "Button on the lobby screen that copies the shareable room link to the clipboard."
  },
  "lobbyCopyCodeButton": "Copy code",
  "@lobbyCopyCodeButton": {
    "description": "Button on the lobby screen that copies the bare room code to the clipboard."
  },
  "lobbyLinkCopied": "Copied to the clipboard.",
  "@lobbyLinkCopied": {
    "description": "Snackbar shown after either the copy-link or the copy-code button on the lobby screen is pressed."
  },
  "lobbyWaitingForPlayers": "Waiting for players ({seated} of {total})",
  "@lobbyWaitingForPlayers": {
    "description": "Shown on the lobby screen with the number of seats currently filled and the number of seats the room needs.",
    "placeholders": {
      "seated": {
        "type": "int"
      },
      "total": {
        "type": "int"
      }
    }
  },
  "lobbyWaitingForHost": "Waiting for the host to start the game",
  "@lobbyWaitingForHost": {
    "description": "Shown on the lobby screen to a guest once every seat is filled, in place of the seat count, while the host has not yet started the game."
  },
  "lobbyDesynced": "The lobby view may be out of date. Resync to be sure.",
  "@lobbyDesynced": {
    "description": "Banner shown on the lobby screen when the controller has detected a gap in the sequence of updates it has received."
  },
  "lobbyResyncButton": "Resync",
  "@lobbyResyncButton": {
    "description": "Button on the desync banner that reopens the connection and resumes the room."
  },
  "lobbyReconnectButton": "Reconnect",
  "@lobbyReconnectButton": {
    "description": "Button shown on the lobby screen after the connection has closed, to open it again."
  },
  "lobbyRetryButton": "Try again",
  "@lobbyRetryButton": {
    "description": "Button shown on the lobby screen after a failed create or join, to send the same request again."
  },
  "lobbyStartButton": "Start game",
  "@lobbyStartButton": {
    "description": "Button shown to the host on the lobby screen that starts the game once every seat is filled."
  },
  "lobbyStartWithPresent": "{count, plural, other{Start with {count} players}}",
  "@lobbyStartWithPresent": {
    "description": "Button shown to the host on the lobby screen, under the Start button, that shrinks the room to the number of seats currently occupied and starts the game with them. Shown only when the room is not full and at least two seats are occupied.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "lobbyRuleBlocksOn": "Blocks: on",
  "@lobbyRuleBlocksOn": {
    "description": "Line under the seat list on the lobby screen naming the state of the blocks rule for this room, shown to host and guests alike."
  },
  "lobbyRuleBlocksOff": "Blocks: off",
  "@lobbyRuleBlocksOff": {
    "description": "Line under the seat list on the lobby screen naming the state of the blocks rule for this room, shown to host and guests alike."
  },
  "lobbyRuleCaptureBonusOn": "Capture bonus: on",
  "@lobbyRuleCaptureBonusOn": {
    "description": "Line under the seat list on the lobby screen naming the state of the capture bonus rule for this room, shown to host and guests alike."
  },
  "lobbyRuleCaptureBonusOff": "Capture bonus: off",
  "@lobbyRuleCaptureBonusOff": {
    "description": "Line under the seat list on the lobby screen naming the state of the capture bonus rule for this room, shown to host and guests alike."
  },
  "lobbyOpenSeat": "Waiting for a friend",
  "@lobbyOpenSeat": {
    "description": "Placeholder card on the lobby screen for a seat nobody has taken yet."
  },
  "seatYou": "You",
  "@seatYou": {
    "description": "Short chip marking the player's own seat card on the lobby screen. Also reused by the game screen's yard label for the same seat."
  },
  "lobbyErrorNoSuchRoom": "That room does not exist. Check the code and try again.",
  "@lobbyErrorNoSuchRoom": {
    "description": "Error shown on the lobby screen when the server reports NO_SUCH_ROOM."
  },
  "lobbyErrorRoomFull": "That room is already full.",
  "@lobbyErrorRoomFull": {
    "description": "Error shown on the lobby screen when the server reports ROOM_FULL."
  },
  "lobbyErrorRoomStarted": "That room has already started its game.",
  "@lobbyErrorRoomStarted": {
    "description": "Error shown on the lobby screen when the server reports ROOM_STARTED."
  },
  "lobbyErrorRateLimited": "Too many tries from this network. Try again later.",
  "@lobbyErrorRateLimited": {
    "description": "Error shown on the lobby screen when the server reports RATE_LIMITED."
  },
  "lobbyErrorTransport": "Could not reach the server. Check your connection and try again.",
  "@lobbyErrorTransport": {
    "description": "Error shown on the lobby screen when the connector itself failed, before any request reached the server."
  },
  "lobbyErrorGeneric": "Something went wrong. Try again.",
  "@lobbyErrorGeneric": {
    "description": "Error shown on the lobby screen for any code not covered by a more specific message, including no code at all."
  },
  "gameScreenTitle": "Game",
  "@gameScreenTitle": {
    "description": "App bar title of the game screen."
  },
  "gameWaitingForStart": "Waiting for the game to start",
  "@gameWaitingForStart": {
    "description": "Shown on the game screen when the room has not started playing yet, or is playing with fewer than two seated players."
  },
  "gameWaitingForTurn": "Waiting for the next turn",
  "@gameWaitingForTurn": {
    "description": "Turn banner shown on the game screen when the room carries no current turn, or when the current turn names a seat no longer present in the room."
  },
  "gameWaitingForPlayer": "Waiting for {name}",
  "@gameWaitingForPlayer": {
    "description": "Turn banner shown on the game screen naming the seat whose turn it currently is, when it is not this player's own turn.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Sam"
      }
    }
  },
  "gameYourTurnRoll": "Your turn. Roll the die.",
  "@gameYourTurnRoll": {
    "description": "Turn banner shown on the game screen when it is this player's own turn and the server is waiting on a roll."
  },
  "gameYourTurnMove": "Your turn. Choose a token to move.",
  "@gameYourTurnMove": {
    "description": "Turn banner shown on the game screen when it is this player's own turn and the server is waiting on a token choice."
  },
  "gameYourTurnStale": "Your turn",
  "@gameYourTurnStale": {
    "description": "Turn banner shown on the game screen when it is this player's own turn while the connection is stale or reconnecting."
  },
  "gameRollButton": "Roll",
  "@gameRollButton": {
    "description": "Label of the button on the game screen that sends the roll intention to the server."
  },
  "gameTokenButton": "Token {number}",
  "@gameTokenButton": {
    "description": "Label of one of the four token buttons on the game screen. The number shown to the player runs 1 to 4 while the protocol token index underneath runs 0 to 3.",
    "placeholders": {
      "number": {
        "type": "int",
        "example": "1"
      }
    }
  },
  "gameDieValue": "Rolled {value}",
  "@gameDieValue": {
    "description": "Shown on the game screen with the value of the last roll, while the server is waiting on a token choice.",
    "placeholders": {
      "value": {
        "type": "int",
        "example": "4"
      }
    }
  },
  "gameTurnCountdown": "{seconds}s left",
  "@gameTurnCountdown": {
    "description": "Shown on the game screen next to the turn banner whenever the current turn carries a deadline, counting down the whole seconds remaining before the server takes the turn. Never negative: it clamps at 0 and holds there until the next turn frame arrives.",
    "placeholders": {
      "seconds": {
        "type": "int",
        "example": "42"
      }
    }
  },
  "gameTurnCountdownDigits": "{seconds}",
  "@gameTurnCountdownDigits": {
    "description": "The bare whole seconds drawn inside the countdown ring, Western digits in both locales by C-250 rule 9b.",
    "placeholders": {
      "seconds": {
        "type": "int",
        "example": "42"
      }
    }
  },
  "gameSeatOffline": "{name} is offline",
  "@gameSeatOffline": {
    "description": "Shown on the game screen under the turn banner when the seat whose turn it currently is has a dropped socket, so the countdown visibly running on nobody has a reason attached to it.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Cy"
      }
    }
  },
  "gameOverYouWin": "You win",
  "@gameOverYouWin": {
    "description": "Shown on the game screen when the game has finished and the winning seat is this player's own."
  },
  "gameOverPlayerWins": "{name} wins",
  "@gameOverPlayerWins": {
    "description": "Shown on the game screen when the game has finished and the winning seat is present in the room, naming that seat's player.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Sam"
      }
    }
  },
  "gameOverEnded": "Game over",
  "@gameOverEnded": {
    "description": "Shown on the game screen when the game has finished but no winning seat can be named, either because the server sent none or because it named a seat no longer present in the room."
  },
  "gameLeaveButton": "Leave",
  "@gameLeaveButton": {
    "description": "The corner icon's tooltip and the confirm's leave action."
  },
  "gameLeaveConfirmTitle": "Leave the game?",
  "@gameLeaveConfirmTitle": {
    "description": "Title of the confirmation bottom sheet shown when leaving an active game."
  },
  "gameLeaveConfirmBody": "Your tokens stay on the board and the timer plays your turns.",
  "@gameLeaveConfirmBody": {
    "description": "Body of the confirmation bottom sheet shown when leaving an active game."
  },
  "gameLeaveConfirmStay": "Keep playing",
  "@gameLeaveConfirmStay": {
    "description": "Primary action on the leave confirmation sheet to keep playing."
  },
  "gameNewRoomButton": "New table",
  "@gameNewRoomButton": {
    "description": "Button on the finished game screen that leaves this room and opens a new table. Distinct from the AppBar Leave control; it does not rematch the same room."
  },
  "gameUndoButton": "Undo",
  "@gameUndoButton": {
    "description": "Label of the outlined control on the game screen that cancels a pending unique-legal auto-move during the three-second hold. Cancels the local hold only; it does not reverse a move on the server."
  },
  "gameVerifyButton": "Verify rolls",
  "@gameVerifyButton": {
    "description": "Button on the finished game screen that opens the match verification page in an external browser. Uses verifiable wording; it does not claim the rolls are proven on this device."
  },
  "gameVerifyOpenFailed": "Could not open the verification page.",
  "@gameVerifyOpenFailed": {
    "description": "Shown when tapping Verify rolls cannot open the external verification URL."
  },
  "gameRollHistoryHeading": "Last rolls",
  "@gameRollHistoryHeading": {
    "description": "Heading above the last few roll faces shown on the finished game screen."
  },
  "gameRollHistoryEmpty": "No rolls to show yet.",
  "@gameRollHistoryEmpty": {
    "description": "Shown under the last-rolls heading when the finished game has no recorded faces."
  },
  "gameRollHistoryEntry": "{k}: {face}",
  "@gameRollHistoryEntry": {
    "description": "One recent roll on the finished game screen: the roll index k and the die face.",
    "placeholders": {
      "k": {
        "type": "int",
        "example": "108"
      },
      "face": {
        "type": "int",
        "example": "4"
      }
    }
  },
  "gameRollNoAnswer": "The roll did not go through. Tap the die again.",
  "@gameRollNoAnswer": {
    "description": "Shown under the die when a roll request got no answer within a few seconds. The die stops tumbling and can be tapped again."
  },
  "gameNoMove": "No move with this roll",
  "@gameNoMove": {
    "description": "Shown next to the die, with a red X on it, when the player's own roll gives no legal move and the turn passes."
  },
  "endWinTitle": "You won!",
  "@endWinTitle": {
    "description": "End-card title when this player's own seat won the game, shown in gold with a celebration behind it."
  },
  "endLoseTitle": "{name} took this one",
  "@endLoseTitle": {
    "description": "End-card title when another seat won the game, naming that seat's player. The name is shown in that seat's own colour; the rest of the line carries no blame or verdict wording.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Sam"
      }
    }
  },
  "endLoseNudge": "So close. One more?",
  "@endLoseNudge": {
    "description": "Warm line under the loser's end-card title, inviting another game rather than stating a result."
  },
  "endStatRolls": "rolls",
  "@endStatRolls": {
    "description": "Label under the rolls count on the end card's stat row."
  },
  "endStatSixes": "sixes",
  "@endStatSixes": {
    "description": "Label under the sixes count on the end card's stat row."
  },
  "endStatCaptures": "captures",
  "@endStatCaptures": {
    "description": "Label under the captures-made count on the end card's stat row."
  },
  "endStatHome": "home",
  "@endStatHome": {
    "description": "Label under the tokens-home count on the end card's stat row. Shown alone, without the other three tiles, when the game's numbers are incomplete."
  },
  "endFairLine": "Every roll of this game is verifiable.",
  "@endFairLine": {
    "description": "One-line fairness statement shown on every end card, win, lose or ended. Plain verifiable wording; casino-style phrasing is forbidden here."
  },
  "endFairCheck": "Check the rolls",
  "@endFairCheck": {
    "description": "Text button on the end card that opens the match's verification page in an external browser. Same destination and behaviour as the page's Verify button; the key game-screen-verify-button is kept on this control."
  },
  "endFairHint": "Each roll came from a sequence sealed before the game started. Anyone can open this page and recheck every roll.",
  "@endFairHint": {
    "description": "Longer explanation shown from the end card's info-hint button next to the fairness line, for a player who has never thought about how the dice are fair."
  },
  "endRematch": "Play again",
  "@endRematch": {
    "description": "Primary action on the end card, and on the lobby screen for a joiner who has not yet accepted a rematch, that sends the rematch request. Also the label of the one-tap accept control a player sees when another seat has already asked for a rematch."
  },
  "endRematchWaiting": "Waiting for the others",
  "@endRematchWaiting": {
    "description": "Shown on the end card in place of the rematch button once this player's own seat has accepted a rematch, while at least one other occupied seat has not yet answered."
  },
  "endRematchAsk": "{name} wants to play again",
  "@endRematchAsk": {
    "description": "Shown on the end card when another seat has asked for a rematch and this player's own seat has not yet answered, naming the seat that asked. Gender-neutral on purpose.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Sam"
      }
    }
  },
  "endRematchStartReady": "Start with {count}",
  "@endRematchStartReady": {
    "description": "Secondary button shown only to the host, under the waiting line, once at least two seats have accepted a rematch but not every occupied seat has. Sends start_game with the ready seats.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "endRematchGone": "This table has closed",
  "@endRematchGone": {
    "description": "Shown on the end card in place of the rematch action when the rematch request answers NO_SUCH_ROOM: the room was reaped before the rematch could be sent. New table becomes the primary action in this state."
  },
  "feedbackHapticsToggle": "Vibration",
  "@feedbackHapticsToggle": {
    "description": "Settings switch that turns game vibration on or off."
  },
  "feedbackSoundToggle": "Sound",
  "@feedbackSoundToggle": {
    "description": "Settings switch that turns game sounds on or off."
  },
  "lobbyShareButton": "Invite friends",
  "@lobbyShareButton": {
    "description": "Main lobby button. Opens the phone's share sheet with the room link and a short invite line."
  },
  "lobbyShareText": "Let's play Ludo! Join my room with this link: {link} or type the code {code} in Ludo RNG.",
  "@lobbyShareText": {
    "description": "The text placed in the share sheet by the lobby Invite friends button. link is the full room link, code is the room code.",
    "placeholders": {
      "link": {
        "type": "String",
        "example": "https://ludo.provefair.app/r/PLAY42"
      },
      "code": {
        "type": "String",
        "example": "PLAY42"
      }
    }
  }
}
