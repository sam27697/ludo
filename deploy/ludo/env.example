# Copy this to /srv/apps/ludo/.env on the server and edit it there. That
# file is never committed (see .gitignore: .env and .env.* are ignored,
# this file is the deliberate exception). Real values never enter the
# repository, never enter a Dockerfile, and never enter a log line.
#
# packages/ludo_server/bin/server.dart reads exactly these two variables plus
# LUDO_VERSION, documented below but deliberately left out of this file.
# Nothing else. If a future change to that file reads a fourth one, it
# belongs here too, and this comment should be updated to say so.

# TCP port the process binds inside the container. Leave this at 8080
# unless the container-internal side of the port mapping in
# docker-compose.yml (127.0.0.1:${LUDO_PORT}:8080) changes at the same
# time -- the two numbers have to agree, or the health check and the
# reverse proxy both stop reaching the process. The host side, LUDO_PORT,
# is not set here: deploy.sh derives it from LUDO_ENVIRONMENT (8199 for
# staging, 8099 for production) and passes it to docker compose directly.
PORT=8080

# Comma-separated list of IP addresses allowed to set X-Forwarded-For and
# have it believed for the client-IP-scoped rate limiting described in
# docs/PROTOCOL.md section 7. Left empty, nobody is trusted and every
# connection is rate-limited by the immediate TCP peer address instead.
#
# That immediate peer address, under rootless Docker's port publishing, is
# NOT necessarily the reverse proxy's real address -- it is whatever
# rootlesskit's userspace port forwarder presents inside this container's
# network namespace, and that has to be confirmed on the real host (for
# example by logging the peer address rootlesskit hands the process and
# checking it against what the reverse proxy actually connects from)
# before this is set to anything. A wrong value here lets any client spoof
# its way around the rate limiter by sending its own X-Forwarded-For
# header. Leaving it empty is always safe; it just means the rate limiter
# scopes by rootlesskit's forwarding address instead of the real client,
# which is a known and accepted limitation until that address is confirmed.
TRUSTED_PROXIES=

# LUDO_VERSION is read by bin/server.dart and echoed back verbatim in the
# "version" field of GET /health. It is not set here on purpose: deploy.sh
# sets it on the command line, per deploy, to the short sha it just built and
# brought up, so the running process reports which build it is. Do not add
# it to this file -- a value hand-maintained here would go stale the moment
# it did not match the sha deploy.sh actually deployed, which defeats the
# point of it. Left unset (as it always is outside of deploy.sh), the process
# reports "dev".
